APP_NAME="Hlídač zákonů"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Prague
APP_LOCALE=cs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=sqlite
# Pro SQLite použijte absolutní cestu. Bez DB_DATABASE se použije data/hlidac.sqlite.
# DB_DATABASE=/absolutni/cesta/data/hlidac.sqlite
# Pro PostgreSQL nastavte DB_CONNECTION=pgsql a následující hodnoty:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=hlidac
# DB_USERNAME=hlidac
# DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
HLIDAC_CRON_TOKEN=
HLIDAC_AI_ENABLED=false
HLIDAC_AI_BACKEND=cli
HLIDAC_AI_CLI_PATH=claude
HLIDAC_AI_REMOTE_TOKEN=
HLIDAC_NOTIFY_DRY_RUN=true
HLIDAC_NOTIFY_POST=all

# Volitelné převzetí původní konfigurace. Pokud má její DSN platit,
# ponechte DB_CONNECTION a další DB_* nenastavené.
# HLIDAC_CONFIG=/absolutni/cesta/config.php
# HLIDAC_DATA_PATH=/absolutni/cesta/data
