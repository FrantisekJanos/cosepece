# Ochrana konfigurace a interních souborů (Apache 2.2 i 2.4)
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|config\.example\.php|.*\.md|.*\.sh|.*\.env.*|.*\.plist|\.gitignore|composer\..*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|bin|data|deploy|docker|rag|reels|tests|podnety)(/|$) - [F,L]
  # soubory a adresáře začínající tečkou (.github, .dockerignore, .gitattributes…), kromě .well-known
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  # hezké adresy bez .php: /tisk/221, /zakon/159/2006, /tisky… Tabulka je v app/Url.php (shodu hlídá test),
  # staré adresy s .php přesměruje app/bootstrap.php. Bez mod_rewrite nastavte v config.php pretty_urls = false.
  RewriteRule ^tisk/([0-9]+)/?$ tisk.php?ct=$1 [L,QSA]
  RewriteRule ^tisk/([0-9]+)/aktualizace/?$ tisk-aktualizace.php?ct=$1 [L,QSA]
  RewriteRule ^zakon/([0-9]{1,4})/([0-9]{4})/?$ zakon.php?z=$1/$2 [L,QSA]
  RewriteRule ^zakony/?$ zakon.php [L,QSA]
  RewriteRule ^data-a-api/?$ data.php [L,QSA]
  RewriteRule ^(tisky|tisk|tisk-aktualizace|upozorneni|aktualizace|pripravovane|metodika|mcp|zmeny|hledat|revize)/?$ $1.php [L,QSA]
  # mapa webu pro vyhledávače
  RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
  # pokyny pro vyhledávače s odkazem na mapu webu
  RewriteRule ^robots\.txt$ robots.php [L,QSA]
</IfModule>

# Bezpečnostní hlavičky: web nejde vložit do cizí stránky (clickjacking), žádné pluginy ani cizí formuláře,
# prohlížeč nepouští kameru, mikrofon a polohu; HSTS jen přes HTTPS (za proxy podle X-Forwarded-Proto)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
</IfModule>
