# Ochrana konfigurace a interních souborů (Apache 2.2 i 2.4)
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|config\.example\.php|.*\.md|.*\.sh|.*\.env.*|.*\.plist|\.gitignore|composer\..*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|bin|data|deploy|tests|podnety)(/|$) - [F,L]
</IfModule>
