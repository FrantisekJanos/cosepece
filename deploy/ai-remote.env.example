# Nastavení pro deploy/ai-remote.sh – zkopírujte jako deploy/ai-remote.env a vyplňte.
# Soubor obsahuje tajný token: nesdílejte ho a nenahrávejte do gitu ani na hosting.

# adresa webu na hostingu (bez lomítka na konci)
HLIDAC_URL="https://vas-web.cz"

# ai.remote_token z config.php na hostingu (nebo cron_token, pokud je remote_token prázdný)
HLIDAC_TOKEN="SEM-VLOZTE-TOKEN"

# kolik textů v jedné dávce (mezi dávkami se na hostingu přepočítá skóre)
AI_LIMIT=20

# volitelně plná cesta k php, pokud ho skript nenajde (např. /opt/homebrew/bin/php)
# PHP_BIN="/opt/homebrew/bin/php"
