MCP_BIND=127.0.0.1:8102
MCP_ALLOWED_HOSTS=mcp.example.cz,localhost:*

# php artisan key:generate --show
APP_KEY=

# Prázdné DSN vypne Sentry. Release nastavuje redeploy.sh z commitu.
SENTRY_DSN=
