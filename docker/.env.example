DB_PASSWORD=zmente
# adresa:port, na které web poslouchá na hostiteli
BIND=127.0.0.1:8100
# MCP server: adresa:port na hostiteli a povolené hlavičky Host (doména za reverzní proxy)
MCP_BIND=127.0.0.1:8102
MCP_ALLOWED_HOSTS=mcp.example.cz,localhost:*

# Sentry pro rag (ingest a MCP): DSN projektu; prázdné = hlášení chyb vypnuto
SENTRY_DSN_RAG=

# Reels (služba reels, reels/README.md): hodnoty jen v docker/.env na serveru, nikdy do gitu.
# Systémový token uživatele Business portfolia s oprávněními stránky a Instagramu
META_SYSTEM_TOKEN=
# id stránky na Facebooku a id účtu Instagram (číselná id z Graph API; sem nevyplňovat, jen do docker/.env)
META_PAGE_ID=
META_IG_USER_ID=
# verze Graph API; prázdné = v23.0
META_GRAPH_VERSION=
# token Telegram bota a id chatu, kam bot posílá videa ke schválení (číslo, u skupin záporné)
REELS_TELEGRAM_TOKEN=
REELS_TELEGRAM_CHAT_ID=
# veřejná adresa složky /reels-media (Instagram si odtud video stáhne); prázdné = https://cosepece.cz/reels-media
REELS_PUBLIC_BASE=
