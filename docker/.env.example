DB_PASSWORD=zmente
# adresa:port, na které web poslouchá na hostiteli
BIND=127.0.0.1:8100
# MCP server: adresa:port na hostiteli a povolené hlavičky Host (doména za reverzní proxy)
MCP_BIND=127.0.0.1:8102
MCP_ALLOWED_HOSTS=mcp.example.cz,localhost:*
# heslo role mcp_ro, pod kterou MCP server čte DB (hodnota jen v docker/.env na serveru, nikdy do gitu);
# vygenerovat openssl rand -hex 24, roli pak založí: docker compose exec -e MCP_DB_PASSWORD rag-ingest python -m hlidac_rag.role
MCP_DB_PASSWORD=

# Sentry pro rag (ingest a MCP): DSN projektu; prázdné = hlášení chyb vypnuto
SENTRY_DSN_RAG=

# Reels (služba reels, reels/README.md): hodnoty jen v docker/.env na serveru, nikdy do gitu.
# Systémový token uživatele Business portfolia s oprávněními stránky a Instagramu
META_SYSTEM_TOKEN=
# id stránky na Facebooku a id účtu Instagram (číselná id z Graph API; sem nevyplňovat, jen do docker/.env)
META_PAGE_ID=
META_IG_USER_ID=
# verze Graph API; prázdné = v23.0
META_GRAPH_VERSION=
# token Telegram bota a id chatu, kam bot posílá videa ke schválení (číslo, u skupin záporné)
REELS_TELEGRAM_TOKEN=
REELS_TELEGRAM_CHAT_ID=
# veřejná adresa složky /reels-media (Instagram si odtud video stáhne); prázdné = https://cosepece.cz/reels-media
REELS_PUBLIC_BASE=
# Threads (volitelné; prázdné THREADS_USER_ID = Reels jen na FB a IG): číselné id účtu Threads
THREADS_USER_ID=
# počáteční dlouhodobý token Threads (60 dní); bot si ho při prvním startu uloží do databáze a sám prodlužuje
THREADS_TOKEN=
# verze Threads API; prázdné = v1.0
THREADS_GRAPH_VERSION=

# Chatbot (služba chat, spec chatbota 10.2, 11.1 a 21): jen názvy, hodnoty jen v docker/.env na serveru, nikdy do gitu.
# Nevyplněná proměnná = výchozí hodnota z kódu (rag/hlidac_rag/chat/config.py). Změna: .env a docker compose up -d chat.
# adresa:port na hostiteli; prázdné = 127.0.0.1:8103
CHAT_BIND=
# hesla rolí chat_ro a chat_rw (openssl rand -hex 24); role založí:
# docker compose exec -e CHAT_DB_RO_PASSWORD -e CHAT_DB_RW_PASSWORD rag-ingest python -m hlidac_rag.role
CHAT_DB_RO_PASSWORD=
CHAT_DB_RW_PASSWORD=
# vlastní klíč Anthropic (workspace s limitem útraty) a vlastní klíč OpenAI s nízkým limitem (embedding dotazu)
CHAT_ANTHROPIC_API_KEY=
CHAT_OPENAI_API_KEY=
# podpis cookie chat_beta (openssl rand -hex 32), kód pro /chat-api/beta a klíč kouřového evalu (hlavička X-Chat-Eval)
CHAT_BETA_KLIC=
CHAT_BETA_KOD=
CHAT_EVAL_KLIC=
# Cloudflare Turnstile
CHAT_TURNSTILE_SITEKEY=
CHAT_TURNSTILE_SECRET=
# vlastní Telegram bot chatu (hlášení útraty)
CHAT_TELEGRAM_TOKEN=
CHAT_TELEGRAM_CHAT=
# vypínač (0 = služba vrací 503, bublina se nevykreslí), režim skryte | verejne, model a effort.
# Provoz: CHAT_MODEL=claude-haiku-5-5 (rozhodnutí po F0); profil Haiku má výchozí effort medium, prázdný CHAT_MODEL
# = claude-sonnet-5-5 s effort low. Effort se váže k modelu: při přepnutí modelu nastav CHAT_EFFORT znovu.
CHAT_ZAPNUTO=
CHAT_REZIM=
CHAT_MODEL=
CHAT_EFFORT=
CHAT_KARTA_JAKO=
CHAT_MODEL_NOUZOVY=
CHAT_PRAH_NOUZE=
CHAT_CENIK=
# stropy v USD a počty zpráv
CHAT_ROZPOCET_DEN_USD=
CHAT_ROZPOCET_MESIC_USD=
CHAT_PODIL_HODINA=
CHAT_STROP_TAHU_USD=
CHAT_STROP_RELACE_USD=
CHAT_STROP_IP_USD=
CHAT_ZPRAV_RELACE_MIN=
CHAT_ZPRAV_RELACE_DEN=
# smyčka, paměť a vstup
CHAT_MAX_KOL=
CHAT_ROZPOCET_VYSLEDKU_TOKENU=
CHAT_MAX_TOKENU_ODPOVEDI=
CHAT_HISTORIE_MAX_TOKENU=
CHAT_MAX_TAHU_KONVERZACE=
CHAT_MAX_ZNAKU_ZPRAVY=
CHAT_KARTA_MAX_TOKENU=
# kapacita, Turnstile a ostatní
CHAT_SOUBEH_CELKEM=
CHAT_SOUBEH_IP=
CHAT_TURNSTILE_ZPRAV=
CHAT_TURNSTILE_HODIN=
CHAT_TURNSTILE_PRISNY_PRAH=
CHAT_DRZENI_TAHU_S=
CHAT_MAX_NAHLASENI_DEN=
# provozovatel a kontakt na stránce zásad (/chat-api/zasady)
CHAT_PROVOZOVATEL=
